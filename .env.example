# --- Site ---
NEXT_PUBLIC_SITE_URL=https://minada.com

# --- Sanity CMS (Phase 5) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
# Read token for previews / drafts (server only)
SANITY_API_TOKEN=
# Write token for seed scripts (server only)
SANITY_API_WRITE_TOKEN=

# --- Lead email: Resend (Phase 4) ---
RESEND_API_KEY=
# Use an address on a domain verified in Resend in production.
RESEND_FROM="MİNADA <form@minada.com.tr>"
# Every calculator and contact-form request is delivered here.
CONTACT_EMAIL=info@minada.com.tr

# --- WhatsApp (public, digits only, incl. country code) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Spam protection: Cloudflare Turnstile (Phase 4) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional lead storage (Postgres) ---
DATABASE_URL=
